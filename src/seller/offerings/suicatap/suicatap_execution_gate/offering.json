{
  "name": "suicatap_execution_gate",
  "price": 0.2,
  "priceV2": { "type": "fixed", "value": 0.2 },
  "description": "SuicaTap Execution Gate — risk-check + executor handoff in one call. Returns PASS/CAUTION/BLOCK verdict with structured SafetyReceipt v2. If PASS, includes execution_handoff payload for Ethy/MIGI/SafeBase. Trading agents: call this BEFORE every swap.",
  "slaMinutes": 10,
  "requirement": {
    "type": "object",
    "required": ["tokenAddress"],
    "properties": {
      "tokenAddress": { "type": "string", "description": "Token contract address (0x...)" },
      "chain": { "type": "string", "enum": ["base", "ethereum", "eth", "bsc"], "default": "base" },
      "amount": { "type": "number", "description": "Amount to swap (optional, for handoff)" },
      "fromToken": { "type": "string", "description": "Token to sell (optional)" }
    }
  },
  "deliverable": {
    "type": "object",
    "required": ["decision", "score", "receipt"],
    "properties": {
      "decision": { "type": "string", "enum": ["PASS", "CAUTION", "BLOCK"] },
      "score": { "type": "number" },
      "receipt": { "type": "object" },
      "execution_handoff": { "type": "object" }
    }
  }
}
