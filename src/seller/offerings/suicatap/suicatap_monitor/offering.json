      },
      "chain": {
        "type": "string",
        "enum": ["base", "ethereum", "eth", "bsc"],
        "default": "base",
        "description": "Chain (default: base)"
      },
      "previousBeep": {
        "type": "string",
        "enum": ["🟢", "🟡", "🔴", ""],
        "description": "Optional: previous beep result to detect changes"
      }
    }
  },
  "jobInput": "Start monitoring 0x833589fcd6edb6e08f4c7c32d4f71b54bda02913 for risk changes on Base",
  "jobOutput": "{\"status\":\"watching\",\"address\":\"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913\",\"chain\":\"base\",\"alert_on\":\"risk_increase OR honeypot\"}",
  "price": 0.1
}
