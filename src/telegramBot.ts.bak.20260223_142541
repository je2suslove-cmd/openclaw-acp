import { Telegraf } from 'telegraf';
import 'dotenv/config';

export function startTelegramBot() {
  const token = process.env.TELEGRAM_BOT_TOKEN;
  
  if (!token) {
    console.warn("⚠️ [Telegram] TELEGRAM_BOT_TOKEN이 없어 봇을 실행하지 않습니다.");
    return;
  }

  const bot = new Telegraf(token);

  bot.start((ctx) => ctx.reply('안녕하세요! SuicaTap 에이전트입니다. 🤖\n(서버 1대에서 ACP와 텔레그램이 동시에 구동 중입니다!)'));

  bot.on('text', (ctx) => {
    ctx.reply(`[SuicaTap 수신] ${ctx.message.text}\n(아직 뇌와 연결 중입니다!)`);
  });

  bot.launch().then(() => {
    console.log("✅ [Telegram] 봇이 백그라운드에서 성공적으로 실행되었습니다.");
  }).catch(err => {
    console.error("🚨 [Telegram] 봇 실행 에러:", err);
  });

  process.once('SIGINT', () => bot.stop('SIGINT'));
  process.once('SIGTERM', () => bot.stop('SIGTERM'));
}
