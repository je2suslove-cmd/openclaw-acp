function clipTelegram(text: string, max = 3500): string {
  const t = (text ?? "").toString();
  return t.length > max ? t.slice(0, max - 20) + "\n...(truncated)" : t;
}

function getText(ctx: any): string {
  const m = ctx?.message;
  return m && typeof m.text === "string" ? m.text : "";
}

function isCmd(text: string, cmd: string): boolean {
  return new RegExp("^\\/" + cmd + "(?:@\\w+)?(?:\\s|$)").test(text.trim());
}

function argsAfter(text: string, cmd: string): string {
  return text.replace(new RegExp("^\\/" + cmd + "(?:@\\w+)?\\s*"), "").trim();
}

async function summarizeForCompaction(input: string, targetChars: number): Promise<string> {
  // compaction은 되도록 짧게/저렴하게
  const model = process.env.GEMINI_COMPACT_MODEL || process.env.GEMINI_MODEL || "gemini-3-flash-preview";
  const out = await geminiGenerate(input, {
    systemInstruction: "You are a compactor. Output Korean bullet summary only. No preamble.",
    model,
    maxInputChars: 12000,
    timeoutMs: 25000,
    retries: 2,
  });
  const t = (out ?? "").toString().trim();
  return t.length > targetChars ? t.slice(0, targetChars - 20) + "\n...(clipped)" : t;
}

