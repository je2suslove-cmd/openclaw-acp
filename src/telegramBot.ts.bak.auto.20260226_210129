import { Telegraf } from 'telegraf';
import { startTaskOps } from "./taskOps.js";
import 'dotenv/config';
import axios from "axios";

async function sleep(ms: number) {
  await new Promise((r) => setTimeout(r, ms));
}

async function launchWithRetry(bot: any) {
  let attempt = 0;
  while (true) {
    try {
      await bot.launch();
console.log("[Telegram] bot launched");
      break;
    } catch (err: any) {
      const code = err?.error_code;
      const msg = err?.description || err?.message || String(err);
      if (code === 409 || msg.includes("getUpdates") || msg.includes("Conflict")) {
        attempt += 1;
        const delay = Math.min(60000, 5000 * Math.pow(2, attempt - 1));
        console.log(`[Telegram] 409 conflict; retry in ${delay}ms (attempt ${attempt})`);
        await sleep(delay);
        continue;
      }
      throw err;
    }
  }
  process.once("SIGINT", () => bot.stop("SIGINT"));
  process.once("SIGTERM", () => bot.stop("SIGTERM"));
}

export function startTelegramBot() {
  const token = process.env.TELEGRAM_BOT_TOKEN;
  
  if (!token) {
    console.warn("⚠️ [Telegram] TELEGRAM_BOT_TOKEN이 없어 봇을 실행하지 않습니다.");
    return;
  }

  const bot = new Telegraf(token);


  const ops = startTaskOps({
    bot,
    runAgent: async (prompt: string, meta: { userId: string }) => {
      // TODO: 여기만 나중에 '진짜 AI 호출'로 교체
      return `echo: ${prompt}`;
    },
  });

  ops.startNightlyScheduler();
  bot.command("risk", async (ctx) => {
    const text = ctx.message?.text ?? "";
    const tokenAddress = text.trim().split(/\s+/)[1];
    if (!tokenAddress) {
      await ctx.reply("사용법: /risk <tokenAddress>");
      return;
    }

    const port = process.env.PORT ?? "8080";
    const base = process.env.SELF_BASE_URL ?? `http://127.0.0.1:${port}`;

    try {
      const { data } = await axios.get(`${base}/r/risk`, {
        params: { tokenAddress },
        timeout: 15000,
      });

      const out = typeof data === "string" ? data : JSON.stringify(data, null, 2);
      const safe = out.length > 3500 ? out.slice(0, 3500) + "\n…(truncated)" : out;

      await ctx.reply(`risk(\${tokenAddress}):\n\n\${safe}`);
    } catch (err) {
      await ctx.reply("리스크 조회 실패. 잠시 후 다시 시도해줘.");
    }
  });


  bot.command("me", async (ctx) => {
    await ctx.reply(`chatId=${ctx.chat.id}\nuserId=${ctx.from?.id ?? "?"}`);
  });

  // 네가 /ME로 치는 습관 있으면 이것도 잡아줌(대문자 커맨드)
  bot.command("ME", async (ctx) => {
    await ctx.reply(`chatId=${ctx.chat.id}\nuserId=${ctx.from?.id ?? "?"}`);
  });

  bot.command("do", async (ctx) => {
    const text = ctx.message.text ?? "";
    const prompt = text.replace(/^\/do(\s+)?/, "").trim();
    if (!prompt) return ctx.reply("사용법: /do <밤새 돌릴 작업>");

    await ops.enqueueTask({
      chatId: ctx.chat.id,
      userId: String(ctx.from?.id ?? "unknown"),
      prompt,
      label: "do",
    });
  });

  bot.command("q", async (ctx) => {
    const { size, pending } = ops.getQueueStats();
    await ctx.reply(`queue size=${size}, pending=${pending}`);
  });

  bot.start((ctx) => ctx.reply('안녕하세요! SuicaTap 에이전트입니다. 🤖\n(서버 1대에서 ACP와 텔레그램이 동시에 구동 중입니다!)'));

  bot.on('text', (ctx) => {
    ctx.reply(`[SuicaTap 수신] ${ctx.message.text}\n(아직 뇌와 연결 중입니다!)`);
  });

  launchWithRetry(bot).then(() => {
    console.log("✅ [Telegram] 봇이 백그라운드에서 성공적으로 실행되었습니다.");
  }).catch(err => {
    console.error("🚨 [Telegram] 봇 실행 에러:", err);
  });

  process.once('SIGINT', () => bot.stop('SIGINT'));
  process.once('SIGTERM', () => bot.stop('SIGTERM'));
}
